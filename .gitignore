# Framework Stata project
# As in R and Python projects, git ignores data by folder, not by file type:
# everything under a private/ folder stays out of git, and so do logs, cache,
# scratch, and tmp folders. Data in other folders, such as a public .dta,
# can be committed. Put data that must stay on this machine under private/.
#
# This project holds restricted data. Everything under a private/ folder stays
# on the machine that may hold it. Only reviewed, de-identified files go in
# public/ folders.

# Stata logs and session files
*.log
*.smcl
*.stswp

# Restricted data
/inputs/private/
/outputs/private/
**/private/**
**/*_private/**
**/sensitive/**

# Keep the folder structure and its documentation
!/inputs/**/README.md
!/inputs/**/.gitkeep
!/outputs/**/README.md
!/outputs/**/.gitkeep

# Secrets and credentials
.env
.env.*
!.env.example
**/credentials/**
**/secrets/**
*.key
*.pem
*.p12
*.pfx

# Logs, cache, and scratch work
**/logs/**
**/cache/**
**/scratch/**
**/tmp/**
slurm-*.out

# System files
.DS_Store
Thumbs.db
*~
*.tmp
*.bak

# --- from base framework/project_sensitive v5 ---
# Private data and credentials
**/private/**
**/*_private/**
.env
.env.*
!.env.example
.Renviron
**/credentials/**
**/secrets/**

# Local records and caches
framework.db
framework.db-wal
framework.db-shm
.DS_Store

# Sensitive project folders
/inputs/private/
/reference/private/
/outputs/private/
**/sensitive/**

# Run logs
/logs/


# NCES documentation for HSLS:09. The fetch scripts download it; the PDFs are
# public but large, so they stay out of git.
/inputs/public/raw/hsls_docs/
/inputs/public/raw/els_docs/
