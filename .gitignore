# What stays out of git, and why
#
# The NCES data: each user downloads them with do/*/01_fetch.do and accepts the
# NCES data usage agreement, and the files are large.
/inputs/raw/els/
/inputs/raw/hsls/
# The NCES documentation PDFs: large, and NCES hosts them. shared/
# data_locations.csv records where each one comes from.
/inputs/raw/els_docs/
/inputs/raw/hsls_docs/
# Files built from the raw data by do/*/02_clean.do: large, and anyone can rebuild
# them.
/inputs/intermediate/
/inputs/final/
# Rendered notebooks, figures, tables, and models: rebuilt from the code.
/outputs/

# Stata logs and session files
*.log
*.smcl
*.stswp

# Secrets and credentials
.env
.env.*
!.env.example
**/credentials/**
**/secrets/**
*.key
*.pem
*.p12
*.pfx

# Logs, cache, and scratch work
**/logs/**
**/cache/**
**/scratch/**
**/tmp/**
slurm-*.out

# System files
.DS_Store
Thumbs.db
*~
*.tmp
*.bak

